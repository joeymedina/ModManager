<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ModManager.Ui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ModManager.Ui.Views.ModsPageView"
             x:DataType="vm:ModsPageViewModel">
  <Design.DataContext>
    <vm:ModsPageViewModel />
  </Design.DataContext>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Mods Folder" FontSize="22" FontWeight="SemiBold" />

      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="Path" VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 PlaceholderText="Mods folder path"
                 Text="{Binding ModsFolderPath}"
                 IsEnabled="{Binding !IsBusy}" />
        <Button Grid.Column="2"
                Content="Refresh"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsBusy}" />
      </Grid>

      <TextBlock Text="{Binding DisabledModsFolderPath, StringFormat='Disabled folder: {0}'}"
                 Opacity="0.75"
                 TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Grid.Column="1"
                 PlaceholderText="Filter by name or folder"
                 Text="{Binding SearchText}" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Enable"
                Command="{Binding EnableSelectedCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Disable"
                Command="{Binding DisableSelectedCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Delete"
                Command="{Binding RequestDeleteSelectedCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Install from file..."
                Command="{Binding RequestInstallFromFileCommand}"
                IsEnabled="{Binding !IsBusy}"
                Margin="16,0,0,0" />
        <CheckBox Content="Group by folder"
                   IsChecked="{Binding GroupByFolder}"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0" />
      </StackPanel>

      <Border IsVisible="{Binding IsInstallPanelVisible}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="8">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="Archive" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1"
                     PlaceholderText="Path to a .zip, .package, or .ts4script file"
                     Text="{Binding ArchivePathToInstall}"
                     IsEnabled="{Binding !IsBusy}" />
            <Button Grid.Column="2"
                    Content="Preview"
                    Command="{Binding PreviewInstallCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Margin="8,0,0,0" />
          </Grid>

          <StackPanel IsVisible="{Binding HasArchivePreview}" Spacing="8">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="Install as" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1"
                       PlaceholderText="Mod folder name"
                       Text="{Binding InstallDisplayName}"
                       IsEnabled="{Binding !IsBusy}" />
            </Grid>

            <ListBox ItemsSource="{Binding ArchivePreviewEntries}"
                     SelectionMode="Multiple"
                     MaxHeight="220"
                     IsEnabled="{Binding !IsBusy}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ArchiveEntryPreviewViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected}"
                              IsEnabled="{Binding IsInstallable}" />
                    <TextBlock Grid.Column="1" Text="{Binding EntryName}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding KindLabel}" Opacity="0.75" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Install" Command="{Binding ConfirmInstallCommand}" IsEnabled="{Binding !IsBusy}" />
              <Button Content="Cancel" Command="{Binding CancelInstallCommand}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding InstallStatusMessage}" TextWrapping="Wrap" Opacity="0.85" />
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding IsDeleteConfirmationVisible}"
              BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding DeleteConfirmationMessage}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
          <Button Content="Delete" Command="{Binding ConfirmDeleteSelectedCommand}" />
          <Button Content="Cancel" Command="{Binding CancelDeleteSelectedCommand}" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid ColumnDefinitions="2*,*">
      <Border Grid.Column="0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="Mod Files"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8" />
          <Panel>
          <ListBox ItemsSource="{Binding Files}"
                   SelectedItems="{Binding SelectedFiles}"
                   SelectionMode="Multiple"
                   IsVisible="{Binding !GroupByFolder}"
                   IsEnabled="{Binding !IsBusy}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModFileViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Opacity="0.75"
                               Text="{Binding Folder, StringFormat='Folder: {0}'}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="⚠"
                               Foreground="Orange"
                               IsVisible="{Binding HasDepthWarning}"
                               ToolTip.Tip="More than one folder below Mods root — this script mod won't load." />
                    <TextBlock Text="{Binding StatusText}" Opacity="0.75" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TreeView ItemsSource="{Binding FolderTree}"
                    SelectedItems="{Binding SelectedTreeNodes}"
                    SelectionMode="Multiple"
                    IsVisible="{Binding GroupByFolder}"
                    IsEnabled="{Binding !IsBusy}">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:ModTreeNodeViewModel" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !IsFolder}">
                    <TextBlock Text="⚠"
                               Foreground="Orange"
                               IsVisible="{Binding File.HasDepthWarning}"
                               ToolTip.Tip="More than one folder below Mods root — this script mod won't load." />
                    <TextBlock Text="{Binding File.StatusText}" Opacity="0.75" />
                  </StackPanel>
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          </Panel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="Details" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DetailHeader}" FontSize="18" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DetailBody}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
