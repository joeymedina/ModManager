<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ModManager.Ui.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:ModManager.Ui.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ModManager.Ui.Views.ModsPageView"
             x:Name="ModsRoot"
             x:DataType="vm:ModsPageViewModel">
  <Design.DataContext>
    <vm:ModsPageViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <!-- Both warnings appear on several row templates and in the details pane; worded once here so
         the explanations can't drift apart. -->
    <x:String x:Key="ConflictExplanation">This file exists in both your Mods folder and the Mods.Disabled folder. The game loads the enabled copy and ignores the other. Mod Manager won't turn it on or off until you delete whichever copy you don't want.</x:String>
    <x:String x:Key="DepthExplanation">Script mods must sit no more than one folder below the Mods root. This one is deeper, so The Sims 4 won't load it. Move it up to fix it.</x:String>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ToggleButton.chip">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Background is set per-instance from CategoryColorConverter, keyed off the category name.
         The padding is deliberately 1px heavier on top than the bottom: a TextBlock reserves room
         below the baseline for descenders, which most category names ("CAS", "UI") never use, so
         even padding leaves the letters riding visibly high in the pill. -->
    <Style Selector="Border.categoryChip">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,3,8,1" />
    </Style>
    <Style Selector="Border.categoryChip TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- The row switch is the state readout, so it carries no On/Off caption of its own. -->
    <Style Selector="ToggleSwitch.row">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.conflict">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20,16,20,0">

    <!-- Header: which folder we're looking at, and the one action that starts a new mod. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="1">
        <TextBlock Text="Mods" Theme="{DynamicResource TitleTextBlockStyle}" />
        <TextBlock Text="{Binding ModsFolderPath}"
                   Classes="label"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding DisabledModsFolderPath, StringFormat='Disabled mods are moved to: {0}'}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsBusy}"
                ToolTip.Tip="Reload from disk">
          <ui:FASymbolIcon Symbol="Refresh" />
        </Button>
        <Button Content="Install from file…"
                Classes="accent"
                Command="{Binding InstallFromFileCommand}"
                IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Grid>

    <!-- Find: search, status chips, and how the list is grouped. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,10">
      <TextBox Grid.Column="0"
               PlaceholderText="Search by name or folder"
               Text="{Binding SearchText}"
               MinWidth="240">
        <TextBox.InnerLeftContent>
          <ui:FASymbolIcon Symbol="Find" Margin="8,0,0,0" Opacity="0.6" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <Button Command="{Binding ClearSearchCommand}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="6,0"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <ui:FASymbolIcon Symbol="Dismiss" />
          </Button>
        </TextBox.InnerRightContent>
      </TextBox>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <ToggleButton Content="All" Classes="chip"
                      Command="{Binding SetStatusFilterCommand}"
                      CommandParameter="{x:Static vm:ModsStatusFilter.All}"
                      IsChecked="{Binding StatusFilter, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ModsStatusFilter.All}}" />
        <ToggleButton Content="Enabled" Classes="chip"
                      Command="{Binding SetStatusFilterCommand}"
                      CommandParameter="{x:Static vm:ModsStatusFilter.Enabled}"
                      IsChecked="{Binding StatusFilter, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ModsStatusFilter.Enabled}}" />
        <ToggleButton Content="Disabled" Classes="chip"
                      Command="{Binding SetStatusFilterCommand}"
                      CommandParameter="{x:Static vm:ModsStatusFilter.Disabled}"
                      IsChecked="{Binding StatusFilter, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ModsStatusFilter.Disabled}}" />
      </StackPanel>

      <ComboBox Grid.Column="2"
                ItemsSource="{Binding CategoryFilterOptions}"
                SelectedItem="{Binding CategoryFilter}"
                MinWidth="130"
                VerticalAlignment="Center"
                ToolTip.Tip="Filter by category" />

      <ComboBox Grid.Column="3"
                ItemsSource="{Binding ListModes}"
                SelectedItem="{Binding ListMode}"
                MinWidth="130"
                VerticalAlignment="Center"
                ToolTip.Tip="How the list is grouped" />
    </Grid>

    <!-- Failures get a bar you have to dismiss; routine counts stay in the status line. -->
    <ui:FAInfoBar Grid.Row="2"
                  Severity="Error"
                  Title="Something went wrong"
                  Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}"
                  IsClosable="True"
                  CloseButtonCommand="{Binding DismissErrorCommand}"
                  Margin="0,0,0,10" />

    <!-- Content: list on the left, details on the right. -->
    <Grid Grid.Row="3" ColumnDefinitions="*,320" ColumnSpacing="12">
      <Grid Grid.Column="0" RowDefinitions="Auto,*">

        <!-- Bulk actions only appear once something is selected. -->
        <Border Grid.Row="0"
                Classes="card"
                Padding="10,6"
                Margin="0,0,0,8"
                IsVisible="{Binding HasSelection}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="4,0,8,0" />
            <Button Content="Enable" Command="{Binding EnableSelectedCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="Disable" Command="{Binding DisableSelectedCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="Group…" Command="{Binding AddToGroupCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="Category…" Command="{Binding SetCategoryCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="More" IsEnabled="{Binding !IsBusy}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Adopt…" Command="{Binding AdoptSelectedCommand}" />
                  <MenuItem Header="Remove from group" Command="{Binding UngroupSelectedCommand}" />
                  <Separator />
                  <MenuItem Header="Delete…" Command="{Binding DeleteSelectedCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="card" Padding="4">
          <Panel>
            <ListBox ItemsSource="{Binding Files}"
                     Padding="0,0,14,0"
                     SelectedItems="{Binding SelectedFiles}"
                     SelectionMode="Multiple"
                     Background="Transparent"
                     IsVisible="{Binding ListMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ModsListMode.Flat}}"
                     IsEnabled="{Binding !IsBusy}">
              <ListBox.ContextFlyout>
                <MenuFlyout>
                  <MenuItem Header="Enable" Command="{Binding EnableSelectedCommand}" />
                  <MenuItem Header="Disable" Command="{Binding DisableSelectedCommand}" />
                  <Separator />
                  <MenuItem Header="Add to group…" Command="{Binding AddToGroupCommand}" />
                  <MenuItem Header="Remove from group" Command="{Binding UngroupSelectedCommand}" />
                  <MenuItem Header="Set category…" Command="{Binding SetCategoryCommand}" />
                  <MenuItem Header="Adopt…" Command="{Binding AdoptSelectedCommand}" />
                  <Separator />
                  <MenuItem Header="Delete…" Command="{Binding DeleteSelectedCommand}" />
                </MenuFlyout>
              </ListBox.ContextFlyout>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ModFileViewModel">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,8">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding FolderText}" Classes="label" TextTrimming="CharacterEllipsis" />
                      <Border Classes="categoryChip"
                              Background="{Binding Category, Converter={x:Static conv:CategoryColorConverter.Instance}}"
                              HorizontalAlignment="Left"
                              IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Category}" />
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <!-- A two-state switch can't say "conflicted", so that state keeps a label. -->
                      <TextBlock Text="Conflicted"
                                 Classes="conflict"
                                 IsVisible="{Binding IsConflicted}"
                                 ToolTip.Tip="{StaticResource ConflictExplanation}" />
                      <ui:FASymbolIcon Symbol="AlertUrgent"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       IsVisible="{Binding HasDepthWarning}"
                                       ToolTip.Tip="{StaticResource DepthExplanation}" />
                      <TextBlock Text="{Binding SizeText}" Classes="label" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  Classes="row"
                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                  Command="{Binding #ModsRoot.((vm:ModsPageViewModel)DataContext).ToggleFileCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Turn this mod on or off" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TreeView ItemsSource="{Binding FolderTree}"
                      Padding="0,0,14,0"
                      SelectedItems="{Binding SelectedTreeNodes}"
                      SelectionMode="Multiple"
                      Background="Transparent"
                      IsVisible="{Binding ListMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ModsListMode.Folder}}"
                      IsEnabled="{Binding !IsBusy}">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:ModTreeNodeViewModel" ItemsSource="{Binding Children}">
                  <!-- The icon and the name share row 0 so they centre on each other, and the chip sits
                       in row 1, which collapses to nothing when hidden. Stacking the name and chip in a
                       StackPanel instead would centre the icon (and the expander chevron, which the
                       TreeViewItem template centres on the whole header) against both lines, leaving the
                       name riding high above them.
                       Column 0 is a fixed width, not Auto, so file rows (icon hidden) still reserve the
                       same space as folder rows and every row's name starts at the same x position. -->
                  <Grid ColumnDefinitions="20,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,8">
                    <ui:FASymbolIcon Grid.Row="0"
                                     Grid.Column="0"
                                     Symbol="Folder"
                                     Opacity="0.6"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsFolder}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Classes="categoryChip"
                            Background="{Binding File.Category, Converter={x:Static conv:CategoryColorConverter.Instance}}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            IsVisible="{Binding File.Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                      <TextBlock Text="{Binding File.Category}" />
                    </Border>
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !IsFolder}">
                      <TextBlock Text="Conflicted"
                                 Classes="conflict"
                                 IsVisible="{Binding File.IsConflicted}"
                                 ToolTip.Tip="{StaticResource ConflictExplanation}" />
                      <ui:FASymbolIcon Symbol="AlertUrgent"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       IsVisible="{Binding File.HasDepthWarning}"
                                       ToolTip.Tip="{StaticResource DepthExplanation}" />
                      <ToggleSwitch Classes="row"
                                    IsChecked="{Binding File.IsEnabled, Mode=OneWay}"
                                    Command="{Binding #ModsRoot.((vm:ModsPageViewModel)DataContext).ToggleFileCommand}"
                                    CommandParameter="{Binding File}"
                                    ToolTip.Tip="Turn this mod on or off" />
                    </StackPanel>
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <TreeView ItemsSource="{Binding GroupTree}"
                      Padding="0,0,14,0"
                      SelectedItems="{Binding SelectedGroupNodes}"
                      SelectionMode="Multiple"
                      Background="Transparent"
                      IsVisible="{Binding ListMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ModsListMode.Group}}"
                      IsEnabled="{Binding !IsBusy}">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:ModGroupNodeViewModel" ItemsSource="{Binding Children}">
                  <!-- Name in row 0, chip in row 1 (collapses when hidden), so the expander chevron
                       centres on the name rather than on both lines. See the folder tree above. -->
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Classes="categoryChip"
                            Background="{Binding File.Category, Converter={x:Static conv:CategoryColorConverter.Instance}}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            IsVisible="{Binding File.Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                      <TextBlock Text="{Binding File.Category}" />
                    </Border>
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <!-- Group headers have no File, and an unresolved path would leave IsVisible
                           at its default of true, labelling every group "Conflicted". -->
                      <TextBlock Text="Conflicted"
                                 Classes="conflict"
                                 IsVisible="{Binding File.IsConflicted, FallbackValue=False}"
                                 ToolTip.Tip="{StaticResource ConflictExplanation}" />
                      <!-- Group nodes and missing members have no file to switch. -->
                      <ToggleSwitch Classes="row"
                                    IsVisible="{Binding File, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    IsChecked="{Binding File.IsEnabled, Mode=OneWay}"
                                    Command="{Binding #ModsRoot.((vm:ModsPageViewModel)DataContext).ToggleFileCommand}"
                                    CommandParameter="{Binding File}"
                                    ToolTip.Tip="Turn this mod on or off" />
                    </StackPanel>
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Panel>
        </Border>
      </Grid>

      <!-- Details for whatever is selected. -->
      <Border Grid.Column="1" Classes="card" Padding="16">
        <ScrollViewer>
          <StackPanel Spacing="14">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding DetailHeader}"
                         Theme="{DynamicResource SubtitleTextBlockStyle}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding DetailSubtitle}" Classes="label" TextWrapping="Wrap" />
            </StackPanel>

            <ContentControl IsVisible="{Binding DetailFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Content="{Binding DetailFile}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ModFileViewModel">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="10,3"
                        HorizontalAlignment="Left">
                  <TextBlock Text="{Binding StatusText}" FontSize="12" />
                </Border>
                <!-- Top-heavy padding for the same reason as the chip style above. -->
                <Border Classes="categoryChip"
                        Background="{Binding Category, Converter={x:Static conv:CategoryColorConverter.Instance}}"
                        CornerRadius="12"
                        Padding="10,4,10,2"
                        IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Category}" FontSize="12" />
                </Border>
              </StackPanel>

              <ui:FAInfoBar Severity="Warning"
                            Title="Two copies of this file"
                            Message="{StaticResource ConflictExplanation}"
                            IsOpen="{Binding IsConflicted, Mode=OneWay}"
                            IsClosable="False" />

              <ui:FAInfoBar Severity="Warning"
                            Title="Won't load"
                            Message="{StaticResource DepthExplanation}"
                            IsOpen="{Binding HasDepthWarning, Mode=OneWay}"
                            IsClosable="False" />

              <StackPanel Spacing="8">
                <StackPanel Spacing="1">
                  <TextBlock Text="Folder" Classes="label" />
                  <TextBlock Text="{Binding FolderText}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="1">
                  <TextBlock Text="Size" Classes="label" />
                  <TextBlock Text="{Binding SizeText}" />
                </StackPanel>
                <StackPanel Spacing="1">
                  <TextBlock Text="Modified" Classes="label" />
                  <TextBlock Text="{Binding ModifiedText}" />
                </StackPanel>
                <StackPanel Spacing="1" IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Version" Classes="label" />
                  <TextBlock Text="{Binding Version}" />
                </StackPanel>
                <StackPanel Spacing="1" IsVisible="{Binding Provider, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Source" Classes="label" />
                  <TextBlock Text="{Binding Provider}" />
                </StackPanel>
                <StackPanel Spacing="1" IsVisible="{Binding InstalledText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Installed" Classes="label" />
                  <TextBlock Text="{Binding InstalledText}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <StackPanel Spacing="6" IsVisible="{Binding DetailFile, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Button Content="Open containing folder"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Command="{Binding RevealInExplorerCommand}" />
              <Button Content="Open mod page"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Command="{Binding OpenModPageCommand}"
                      IsVisible="{Binding DetailFile.HasModPage}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Quiet status line: counts and progress, never modal. -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,8" ColumnSpacing="12">
      <TextBlock Grid.Column="0"
                 Text="{Binding StatusMessage}"
                 Classes="label"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
      <ProgressBar Grid.Column="1"
                   IsIndeterminate="True"
                   Width="120"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsBusy}" />
    </Grid>
  </Grid>
</UserControl>
