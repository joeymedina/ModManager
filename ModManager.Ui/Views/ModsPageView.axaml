<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ModManager.Ui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ModManager.Ui.Views.ModsPageView"
             x:DataType="vm:ModsPageViewModel">
  <Design.DataContext>
    <vm:ModsPageViewModel />
  </Design.DataContext>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Mods Folder" FontSize="22" FontWeight="SemiBold" />

      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="Path" VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 PlaceholderText="Mods folder path"
                 Text="{Binding ModsFolderPath}"
                 IsEnabled="{Binding !IsBusy}" />
        <Button Grid.Column="2"
                Content="Refresh"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsBusy}" />
      </Grid>

      <TextBlock Text="{Binding DisabledModsFolderPath, StringFormat='Disabled folder: {0}'}"
                 Opacity="0.75"
                 TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Grid.Column="1"
                 PlaceholderText="Filter by name or folder"
                 Text="{Binding SearchText}" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Enable"
                Command="{Binding EnableSelectedCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Disable"
                Command="{Binding DisableSelectedCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="Delete"
                Command="{Binding RequestDeleteSelectedCommand}"
                IsEnabled="{Binding !IsBusy}" />
      </StackPanel>

      <Border IsVisible="{Binding IsDeleteConfirmationVisible}"
              BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding DeleteConfirmationMessage}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
          <Button Content="Delete" Command="{Binding ConfirmDeleteSelectedCommand}" />
          <Button Content="Cancel" Command="{Binding CancelDeleteSelectedCommand}" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid ColumnDefinitions="2*,*">
      <Border Grid.Column="0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="Mod Files"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8" />
          <ListBox ItemsSource="{Binding Files}"
                   SelectedItems="{Binding SelectedFiles}"
                   SelectionMode="Multiple"
                   IsEnabled="{Binding !IsBusy}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModFileViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Opacity="0.75"
                               Text="{Binding Folder, StringFormat='Folder: {0}'}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding StatusText}"
                             VerticalAlignment="Center"
                             Opacity="0.75" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="Details" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DetailHeader}" FontSize="18" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DetailBody}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
